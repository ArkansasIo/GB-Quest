{
  "name": "Lost Kingdom of Shadowbane Chronicles",
  "applicationId": "io.arkansasio.gbquest",
  "version": "0.3.0",
  "runtime": "html5",
  "language": "javascript",
  "entryPoint": "index.html",
  "browser": {
    "defaultEntryPoint": "dist/gbquest-fullscreen.html",
    "windowedEntryPoint": "dist/gbquest.html",
    "fullscreenEntryPoint": "dist/gbquest-fullscreen.html",
    "displayMode": "viewport",
    "fullscreenApi": true,
    "fullscreenRequiresUserGesture": true
  },
  "java": {
    "jarRequired": false,
    "jarClassName": "io.arkansasio.gbquest.Main",
    "launcherProject": "java-launcher/",
    "buildCommand": "mvn clean package",
    "artifact": "java-launcher/target/gbquest-browser-launcher-0.3.0.jar",
    "minimumJavaVersion": 17,
    "description": "Optional Java JAR launcher that opens the HTML5 game in the default browser. The game itself is not a Java application."
  },
  "viewport": {
    "width": 160,
    "height": 144,
    "aspectRatio": "10:9",
    "scaling": "integer-pixel-preferred",
    "fit": "contain",
    "allowResponsiveResize": true
  },
  "rendering": {
    "renderer": "Canvas 2D",
    "canvasId": "lcd"
  }
}
