# Copy to .env and replace both secrets before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-password
GBQ_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Optional comma-separated exact HTTPS origins allowed to call the API.
# Leave empty to allow HTTPS origins; WebSocket clients still require WSS at deployment.
GBQ_ALLOWED_ORIGINS=
