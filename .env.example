# Copy this file to .env and replace both secret placeholders.
POSTGRES_DB=gbquest
POSTGRES_USER=gbquest
# Use a hexadecimal/alphanumeric password (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_VALUE

# Generate with: openssl rand -hex 48
GBQ_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS

# Exact browser origins only, comma-separated. Include the production HTTPS game origin.
GBQ_ALLOWED_ORIGINS=http://localhost:8788,http://127.0.0.1:8788,https://YOUR-GAME-DOMAIN.example

# Loopback is safest behind a TLS reverse proxy on the same host.
# Set to 0.0.0.0 only for trusted LAN testing.
MMO_BIND_ADDRESS=127.0.0.1
MMO_PORT=8788
DB_POOL_SIZE=10
GBQ_WS_AUTH_TIMEOUT_MS=10000
GBQ_WS_HEARTBEAT_MS=30000
GBQ_WS_MAX_BUFFERED_BYTES=1048576
