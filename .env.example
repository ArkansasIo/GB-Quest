# Copy to .env and replace every placeholder before starting the service.
POSTGRES_DB=gbquest
POSTGRES_USER=gbquest
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# Generate with: openssl rand -hex 48
GBQ_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Exact browser origins only, comma-separated. Example:
# GBQ_ALLOWED_ORIGINS=https://your-game.example.com,https://your-itch-page.itch.io
GBQ_ALLOWED_ORIGINS=https://your-game.example.com

# Keep the service bound to localhost when using a reverse proxy.
GBQ_BIND_ADDRESS=127.0.0.1
GBQ_PORT=8788
DB_POOL_SIZE=10
