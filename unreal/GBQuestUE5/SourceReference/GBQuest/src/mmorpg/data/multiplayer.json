    "party.ready",
    "chat.send",
    "zone.enter",
    "zone.snapshot",
    "movement.input",
    "combat.intent",
    "quest.share",
    "quest.progress",
    "loot.roll",
    "ping",
    "pong",
    "error"
  ],
  "security": [
    "Never trust client damage or rewards",
    "Validate every inventory and currency transaction server-side",
    "Rate-limit chat, movement and action messages",
    "Use per-character ownership checks",
    "Keep authentication secrets server-side"
  ],
  "note": "This is a protocol and data contract. It is not a deployed multiplayer server; live online play requires an authenticated WebSocket service, database and authoritative simulation."
