# Copy to .env.cluster and replace all values before deployment.
POSTGRES_DB=gbquest
POSTGRES_USER=gbquest
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
GBQ_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES_HEX
# Comma-separated exact origins, e.g. https://your-game.example,https://your-itch-page.example
GBQ_ALLOWED_ORIGINS=https://your-game.example
GBQ_BIND_ADDRESS=0.0.0.0
GBQ_PUBLIC_PORT=8788
DB_POOL_SIZE=20
GBQ_PRESENCE_TTL_SECONDS=45
