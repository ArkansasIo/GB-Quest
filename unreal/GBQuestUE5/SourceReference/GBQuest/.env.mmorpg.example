# Copy to .env and replace both secrets before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-password
GBQ_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Comma-separated exact HTTPS origins allowed to call the API and WebSocket.
# Example: https://yourname.itch.io,https://game.example.com
# Leave empty to deny remote browser origins (localhost remains allowed for development).
GBQ_ALLOWED_ORIGINS=
# Host-side bind address and port; keep loopback unless a reverse proxy needs host access.
GBQ_BIND_ADDRESS=127.0.0.1
GBQ_PORT=8788
