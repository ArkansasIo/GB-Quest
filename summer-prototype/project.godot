; Lost Kingdom of Shadowbane Chronicles - Godot 4 / Summer Engine port (prototype)
; Data and art come from the browser game: run `node tools/export_godot.cjs` from the repository root first.
config_version=5

[application]
config/name="GB-Quest (Summer port)"
config/description="Godot 4 port of Lost Kingdom of Shadowbane Chronicles at HD 4x (640x576)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[autoload]
Data="*res://scripts/data.gd"
Game="*res://scripts/game.gd"
Craft="*res://scripts/craft.gd"
Quest="*res://scripts/quest.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
